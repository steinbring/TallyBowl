<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- AndroidX test helpers request task reordering; the owner app does not
         need that permission. Keep it out of distributed debug APKs too. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" tools:node="remove" />
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
